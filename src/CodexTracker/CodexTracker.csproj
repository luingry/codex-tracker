<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\brand\codex-tracker.ico</ApplicationIcon>
    <Version>0.4.10</Version>
    <AssemblyVersion>0.4.10.0</AssemblyVersion>
    <FileVersion>0.4.10.0</FileVersion>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\CodexTracker.Core\CodexTracker.Core.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="..\..\assets\fonts\SourceSans3.ttf" Link="assets\fonts\SourceSans3.ttf" /><Resource Include="..\..\assets\fonts\AtkinsonHyperlegibleNext.ttf" Link="assets\fonts\AtkinsonHyperlegibleNext.ttf" /></ItemGroup>
</Project>
