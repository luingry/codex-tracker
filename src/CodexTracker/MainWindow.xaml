<Window x:Class="CodexTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexTracker"
        Title="Codex Tracker"
        Width="62" Height="52" MinWidth="62" MinHeight="52"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="./assets/fonts/#Atkinson Hyperlegible Next">
  <Border x:Name="WindowSurface" CornerRadius="12" ClipToBounds="True" SnapsToDevicePixels="True">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding Expanded}" Value="True">
            <Setter Property="Background" Value="{DynamicResource DetailedSurface}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding Visibility, ElementName=SettingsPanel}" Value="Visible">
            <Setter Property="Background" Value="{DynamicResource SettingsSurface}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <Grid x:Name="Root" MouseLeftButtonDown="DragWindow" MouseEnter="ShowChrome" MouseLeave="HideChrome">
      <Grid x:Name="MainContent">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Visible" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Visibility, ElementName=SettingsPanel}" Value="Visible">
                <!-- Preserve the root measure while Settings expands the window. Collapsing
                     this subtree could leave the sibling settings visual unarranged for a frame. -->
                <Setter Property="Opacity" Value="0" />
                <Setter Property="IsHitTestVisible" Value="False" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <!-- The compact gauge is vector-laid out at its final size; no region crop or Viewbox raster scaling. -->
        <Grid Visibility="{Binding Expanded, Converter={StaticResource CompactVisibility}}">
          <Grid Width="{Binding ActualHeight, ElementName=Root, Converter={StaticResource CompactGaugeDiameter}, ConverterParameter=Gauge}"
                Height="{Binding ActualHeight, ElementName=Root, Converter={StaticResource CompactGaugeDiameter}, ConverterParameter=Gauge}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
              <Ellipse Width="{Binding ActualHeight, ElementName=Root, Converter={StaticResource CompactGaugeDiameter}, ConverterParameter=Background}"
                       Height="{Binding ActualHeight, ElementName=Root, Converter={StaticResource CompactGaugeDiameter}, ConverterParameter=Background}"
                       Fill="{DynamicResource GlassSurface}" />
              <local:CircularQuotaGauge x:Name="CompactQuotaGauge" AutomationProperties.Name="Indicador de quota semanal restante" Value="{Binding RemainingPercent}"
                                       TrackBrush="{DynamicResource GaugeTrack}" ProgressBrush="{DynamicResource Accent}" StrokeThickness="3" />
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Weekly}" FontFamily="./assets/fonts/#Source Sans 3" FontSize="{Binding ActualWidth, ElementName=Root, Converter={StaticResource CompactGaugeDiameter}, ConverterParameter=FontSize}" FontWeight="Bold"
                           Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" Margin="0,0,0,0" />
              </StackPanel>
            </Grid>
        </Grid>

        <ScrollViewer x:Name="DetailedScrollViewer" Visibility="{Binding Expanded, Converter={StaticResource BooleanToVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="12">
          <StackPanel x:Name="DetailedContent" LayoutUpdated="DetailedContentLayoutUpdated">
            <Grid Margin="0,3,0,13">
              <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Grid Width="72" Height="72" HorizontalAlignment="Left">
                <local:CircularQuotaGauge AutomationProperties.Name="Indicador de quota semanal restante" Value="{Binding RemainingPercent}"
                                         TrackBrush="{DynamicResource GaugeTrack}" ProgressBrush="{DynamicResource Accent}" StrokeThickness="4" />
                <TextBlock Text="{Binding Weekly}" FontFamily="./assets/fonts/#Source Sans 3" FontSize="19.55" FontWeight="Bold"
                           Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0">
                <TextBlock Text="WEEKLY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SoftInk}" />
                <TextBlock Text="{Binding Reset}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource SoftInk}" Margin="0,3,0,0" />
                <TextBlock Text="{Binding Forecast}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource SoftInk}" />
                      <Setter Property="FontWeight" Value="Normal" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExhaustionRisk}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource RiskWarning}" />
                          <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /></Grid.RowDefinitions>
              <TextBlock Text="HOJE" FontSize="8" Foreground="{DynamicResource SoftInk}" />
              <TextBlock Grid.Column="2" Text="SEMANA" FontSize="8" Foreground="{DynamicResource SoftInk}" Margin="7,0" />
              <TextBlock Grid.Column="4" Text="MÊS" FontSize="8" Foreground="{DynamicResource SoftInk}" Margin="7,0,0,0" />
              <TextBlock Grid.Row="1" Text="{Binding Today}" FontFamily="./assets/fonts/#Source Sans 3" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding WeeklyTokens}" FontFamily="./assets/fonts/#Source Sans 3" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="7,0" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding Month}" FontFamily="./assets/fonts/#Source Sans 3" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="7,0,0,0" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="2" Text="{Binding TodayCost}" FontSize="9" Foreground="{DynamicResource SoftInk}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding WeeklyCost}" FontSize="9" Foreground="{DynamicResource SoftInk}" Margin="7,1" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding MonthCost}" FontSize="9" Foreground="{DynamicResource SoftInk}" Margin="7,1,0,0" TextTrimming="CharacterEllipsis" />
              <Border Grid.Column="1" Grid.RowSpan="3" Width="1" Background="{DynamicResource GaugeTrack}" Margin="0,2,0,1" />
              <Border Grid.Column="3" Grid.RowSpan="3" Width="1" Background="{DynamicResource GaugeTrack}" Margin="0,2,0,1" />
            </Grid>
            <TextBlock Text="{Binding Coverage}" FontSize="10" Foreground="{DynamicResource SoftInk}" Margin="0,4,0,12" />
            <Grid Margin="0,10,0,3">
              <TextBlock Text="Ranking de uso" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" />
              <Grid HorizontalAlignment="Right" Height="24" Width="144">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource InputSurface}" CornerRadius="12" Grid.ColumnSpan="3" />
                <Border Background="{DynamicResource Sage}" CornerRadius="10" Margin="2">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Grid.Column" Value="2" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRankingDay}" Value="True"><Setter Property="Grid.Column" Value="0" /></DataTrigger>
                        <DataTrigger Binding="{Binding IsRankingWeek}" Value="True"><Setter Property="Grid.Column" Value="1" /></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                </Border>
                <Grid Grid.ColumnSpan="3">
                  <Grid.Resources>
                    <Style TargetType="RadioButton">
                      <Setter Property="Background" Value="Transparent" />
                      <Setter Property="FontSize" Value="9" />
                      <Setter Property="HorizontalContentAlignment" Value="Center" />
                      <Setter Property="VerticalContentAlignment" Value="Center" />
                      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border Background="{TemplateBinding Background}" CornerRadius="10"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" /></Border></ControlTemplate></Setter.Value></Setter>
                    </Style>
                  </Grid.Resources>
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <RadioButton Grid.Column="0" GroupName="RankingPeriod" Content="dia" IsChecked="{Binding IsRankingDay, Mode=TwoWay}" Foreground="{DynamicResource Ink}" AutomationProperties.Name="Período do ranking: dia" />
                  <RadioButton Grid.Column="1" GroupName="RankingPeriod" Content="semana" IsChecked="{Binding IsRankingWeek, Mode=TwoWay}" Foreground="{DynamicResource Ink}" AutomationProperties.Name="Período do ranking: semana" />
                  <RadioButton Grid.Column="2" GroupName="RankingPeriod" Content="mês" IsChecked="{Binding IsRankingMonth, Mode=TwoWay}" Foreground="{DynamicResource Ink}" AutomationProperties.Name="Período do ranking: mês" />
                </Grid>
              </Grid>
            </Grid>
            <ItemsControl ItemsSource="{Binding Ranking}" Margin="0,0,0,0">
              <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Model}" FontSize="11" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" /><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding Tokens}" FontSize="10" Foreground="{DynamicResource Ink}" /><TextBlock Text="{Binding TariffNote}" FontSize="8" Foreground="{DynamicResource SoftInk}" HorizontalAlignment="Right" /></StackPanel></Grid><ProgressBar Value="{Binding Fraction}" Maximum="1" Height="4" Background="{DynamicResource Sage}" Foreground="{DynamicResource Accent}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Margin="0,13,0,0">
              <TextBlock Text="USO DIÁRIO · MÊS ATUAL" FontSize="9" Foreground="{DynamicResource SoftInk}" Margin="0,0,0,5" />
              <local:DailyUsageChart Series="{Binding DailyTokenSeries}" Height="76"
                                     CurrencyCode="{Binding CurrencyCode}"
                                     BarBrush="{DynamicResource Accent}" TrackBrush="{DynamicResource GaugeTrack}"
                                     LabelBrush="{DynamicResource SoftInk}" TooltipSurface="{DynamicResource InputSurface}"
                                     TooltipTextBrush="{DynamicResource Ink}" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" FontSize="9" Foreground="{DynamicResource Accent}" Margin="0,10,0,2" />
            <TextBlock Text="{Binding AppVersion}" FontSize="12" Foreground="{DynamicResource SoftInk}" HorizontalAlignment="Center" Margin="0,7,0,0" />
          </StackPanel>
        </ScrollViewer>

        <Grid x:Name="Chrome" Panel.ZIndex="2" VerticalAlignment="Top" HorizontalAlignment="Right" Opacity="0"
              Visibility="{Binding Expanded, Converter={StaticResource BooleanToVisibility}}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Button Grid.Column="0" Click="Settings" ToolTip="Configurações" AutomationProperties.Name="Configurações" Padding="5"><Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Data="M12.22,2H11.78A2,2 0 0,0 9.78,4V4.18A2,2 0 0,1 8.78,5.91L8.35,6.16A2,2 0 0,1 6.35,6.16L6.2,6.08A2,2 0 0,0 3.47,6.81L3.25,7.19A2,2 0 0,0 3.98,9.92L4.13,10.02A2,2 0 0,1 5.13,11.74V12.25A2,2 0 0,1 4.13,13.99L3.98,14.08A2,2 0 0,0 3.25,16.81L3.47,17.19A2,2 0 0,0 6.2,17.92L6.35,17.84A2,2 0 0,1 8.35,17.84L8.78,18.09A2,2 0 0,1 9.78,19.82V20A2,2 0 0,0 11.78,22H12.22A2,2 0 0,0 14.22,20V19.82A2,2 0 0,1 15.22,18.09L15.65,17.84A2,2 0 0,1 17.65,17.84L17.8,17.92A2,2 0 0,0 20.53,17.19L20.75,16.81A2,2 0 0,0 20.02,14.08L19.87,13.99A2,2 0 0,1 18.87,12.25V11.74A2,2 0 0,1 19.87,10L20.02,9.91A2,2 0 0,0 20.75,7.18L20.53,6.8A2,2 0 0,0 17.8,6.07L17.65,6.15A2,2 0 0,1 15.65,6.15L15.22,5.9A2,2 0 0,1 14.22,4.17V4A2,2 0 0,0 12.22,2Z" Stroke="{DynamicResource SoftInk}" StrokeThickness="1.4" /><Ellipse Canvas.Left="9" Canvas.Top="9" Width="6" Height="6" Stroke="{DynamicResource SoftInk}" StrokeThickness="1.4" /></Canvas></Viewbox></Button>
          <Button Grid.Column="1" Click="ToggleDetailed" ToolTip="Alternar modo compacto/detalhado" AutomationProperties.Name="Alternar modo compacto/detalhado" Padding="5"><Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Data="M5,7H19M5,12H19M5,17H19" Stroke="{DynamicResource SoftInk}" StrokeThickness="1.7" StrokeStartLineCap="Round" /></Canvas></Viewbox></Button>
          <Button Grid.Column="2" Click="ToggleTopmost" ToolTip="Sempre no topo" AutomationProperties.Name="Sempre no topo" Padding="5"><Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Data="M9,3H15L14,9L18,13H6L10,9Z M12,13V21" Stroke="{DynamicResource SoftInk}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox></Button>
          <Button Grid.Column="3" Click="CloseWindow" ToolTip="Ocultar" AutomationProperties.Name="Ocultar" Padding="5"><Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Data="M18,6L6,18M6,6L18,18" Stroke="{DynamicResource SoftInk}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox></Button>
        </Grid>
      </Grid>

        <Grid x:Name="SettingsPanel" Visibility="Collapsed" Background="{DynamicResource SettingsSurface}" Panel.ZIndex="3"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <Border Background="{DynamicResource SettingsSurface}" CornerRadius="12" ClipToBounds="True">
            <Grid Margin="18">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid>
                <TextBlock Text="Configurações" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                <Button HorizontalAlignment="Right" Click="Settings" ToolTip="Fechar configurações" AutomationProperties.Name="Fechar configurações" Padding="5"><Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Data="M18,6L6,18M6,6L18,18" Stroke="{DynamicResource SoftInk}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox></Button>
              </Grid>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,12">
                <StackPanel>
                  <CheckBox x:Name="DetailedBox" Content="Modo detalhado" Foreground="{DynamicResource Ink}" />
                  <CheckBox x:Name="TopmostBox" Content="Sempre no topo" Foreground="{DynamicResource Ink}" Margin="0,8,0,0" />
                  <Grid Margin="0,16,0,3"><TextBlock Text="Tema escuro" Foreground="{DynamicResource SoftInk}" VerticalAlignment="Center" /><CheckBox x:Name="ThemeToggle" Content="Tema escuro" HorizontalAlignment="Right" Style="{StaticResource ThemeSwitch}" AutomationProperties.Name="Tema escuro" ToolTip="Alternar tema claro ou escuro" Checked="PreviewTheme" Unchecked="PreviewTheme" /></Grid>
                  <TextBlock Text="Moeda" Foreground="{DynamicResource SoftInk}" Margin="0,14,0,3" /><ComboBox x:Name="CurrencyBox" SelectionChanged="CurrencyChanged"><ComboBoxItem Tag="BRL">BRL (R$)</ComboBoxItem><ComboBoxItem Tag="USD">USD (US$)</ComboBoxItem></ComboBox>
                  <StackPanel x:Name="RatePanel"><TextBlock Text="Taxa USD para BRL (manual)" Foreground="{DynamicResource SoftInk}" Margin="0,14,0,3" /><TextBox x:Name="RateBox" /></StackPanel>
                  <TextBlock Text="Caminho do Codex" Foreground="{DynamicResource SoftInk}" Margin="0,14,0,3" /><TextBox x:Name="PathBox" />
                  <WrapPanel Margin="0,12,0,0"><Button Click="Browse" Content="Procurar" /><Button Click="AutoDetect" Content="Auto" /><Button Click="TestPath" Content="Testar" /><Button Click="OpenLog" Content="Abrir log" /></WrapPanel>
                </StackPanel>
              </ScrollViewer>
              <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Click="Settings" Content="Cancelar" /><Button Click="ApplySettings" Content="Aplicar" Background="{DynamicResource Sage}" Foreground="{DynamicResource Ink}" /></StackPanel>
            </Grid>
          </Border>
        </Grid>
    </Grid>
  </Border>
</Window>
